# Postgres: dados não sensíveis. A senha fica em secrets/db_password.txt
POSTGRES_USER=app
POSTGRES_DB=trails

# Portas do nginx no host (o único container com porta publicada).
# O app fica em https://localhost:HTTPS_PORT; a HTTP_PORT só redireciona para lá.
# O Better Auth usa essa mesma URL (montada no docker-compose.yml).
# O segredo do Better Auth fica em secrets/better_auth_secret.txt
HTTPS_PORT=8443
HTTP_PORT=8080

# Assistente de IA. gemini: usa a chave de secrets/gemini_api_key.txt (vazia = assistente desligado);
# mock: texto fixo, sem chave e sem gastar cota (para desenvolver e testar).
# Os limites são por usuário e somam o planejador e as perguntas.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
AI_LIMIT_PER_MINUTE=5
AI_LIMIT_PER_DAY=50
