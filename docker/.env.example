# Postgres: dados não sensíveis. A senha fica em secrets/db_password.txt
POSTGRES_USER=app
POSTGRES_DB=trails

# Portas do nginx no host (o único container com porta publicada).
# O app fica em https://localhost:HTTPS_PORT; a HTTP_PORT só redireciona para lá.
# O Better Auth usa essa mesma URL (montada no docker-compose.yml).
# O segredo do Better Auth fica em secrets/better_auth_secret.txt
HTTPS_PORT=8443
HTTP_PORT=8080
