# Único ponto de entrada do app: termina o HTTPS e repassa tudo para o Next.js na rede interna.
# @HTTPS_PORT@ é trocado pelo entrypoint.

user nginx;
worker_processes auto;
pid /run/nginx.pid;   # o padrão do Alpine, /run/nginx/, não existe na imagem

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    client_max_body_size 10m;

    # WebSocket: só pede "upgrade" quando o navegador pediu (HMR do next dev e, depois, o tempo real)
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # HTTP só redireciona
    server {
        listen 80;
        return 301 https://$host:@HTTPS_PORT@$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;

        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://nextjs:3000;
            proxy_hide_header X-Powered-By;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Host com a porta: as Server Actions comparam com o Origin do navegador
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            # Sobrescreve (não acrescenta): o cliente não consegue forjar o IP que o rate limit do login usa
            proxy_set_header X-Forwarded-For $remote_addr;

            # Respostas em streaming (IA) chegam aos poucos, sem esperar o buffer encher
            proxy_buffering off;
            proxy_read_timeout 1h;
        }
    }
}
